#!/bin/sh
# Stub `df` for the integration fake host. The host driver runs
# `df -P -k <path>` and reads the 4th field of the last output line as the
# available 1024-byte block count; this stub reports a healthy figure.
path="/var/db/tart-fleet"
if [ "${1:-}" = "-P" ] && [ "${2:-}" = "-k" ] && [ -n "${3:-}" ]; then
  path="${3}"
fi
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n'
printf 'fakefs 100000000 1000000 99000000 1%% %s\n' "$path"
exit 0
